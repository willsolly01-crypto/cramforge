# Copy this file to .env.local and fill in your values.
# Never commit .env or .env.local — they are in .gitignore.

# ── Supabase ──────────────────────────────────────────────────
# From: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Service role key — server-side only, never expose to browser
# From: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Anthropic ─────────────────────────────────────────────────
# From: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe ────────────────────────────────────────────────────
# From: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...

# From: Stripe → Products → your Pro plan → Price ID
STRIPE_PRICE_ID=price_...

# Webhook signing secret — from: Stripe Dashboard → Developers → Webhooks
# Set endpoint URL to: https://cramforge.app/api/webhook
# Events to enable: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Resend (onboarding emails) ────────────────────────────────
# From: resend.com → API Keys. Verify your sending domain first.
# Update the "from" address in api/_auth.js to match your verified domain.
RESEND_API_KEY=re_...

# ── App URL ───────────────────────────────────────────────────
# Optional — auto-detected from req.headers.host on Vercel.
# Set explicitly if you use a custom domain.
# APP_URL=https://cramforge.app

# ── Google OAuth ("Continue with Google") ────────────────────
# No env vars needed here — configured entirely in Supabase Dashboard.
# Steps:
#   1. console.cloud.google.com → APIs & Services → Credentials → Create OAuth 2.0 Client
#   2. Authorised redirect URI: https://yourproject.supabase.co/auth/v1/callback
#   3. Supabase Dashboard → Authentication → Providers → Google → paste Client ID + Secret

# ── Apple OAuth ("Continue with Apple") ──────────────────────
# No env vars needed here — configured entirely in Supabase Dashboard.
# Steps:
#   1. Requires Apple Developer account → Certificates → Services ID
#   2. Register redirect URL: https://yourproject.supabase.co/auth/v1/callback
#   3. Supabase Dashboard → Authentication → Providers → Apple → paste credentials
